# LLM — LiteLLM self-host (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://llm.vinhpham.com.vn/v1
LLM_MODEL=
# reasoning_effort: "disable" tat thinking (Gemini/Claude) tranh JSON bi cat; de trong neu model khong ho tro
LLM_REASONING_EFFORT=disable
# Cloudflare Access service token (neu LLM endpoint dat sau Cloudflare Access)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Airtable Personal Access Token (scope: data.records read+write + webhook:manage)
AIRTABLE_TOKEN=
# Airtable base/field (override khi doi account/base; de trong = dung default trong config.py)
AIRTABLE_BASE_ID=
PROPOSAL_FILE_FIELD_ID=
