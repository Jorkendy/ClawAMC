# LLM — LiteLLM self-host (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://llm.vinhpham.com.vn/v1
LLM_MODEL=
# Bat khi backend la Qwen ho tro tat thinking (de trong neu khong dung)
LLM_DISABLE_THINKING=
# Cloudflare Access service token (neu LLM endpoint dat sau Cloudflare Access)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Airtable Personal Access Token (scope: data.records read+write + webhook:manage)
AIRTABLE_TOKEN=
